/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # camera=(self) required for facial enroll / attendance kiosk (getUserMedia)
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  # CSP — own scripts + Cloudflare Web Analytics beacon; backend over HTTPS; camera streams via blob:
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' blob:; worker-src blob:; manifest-src 'self'; frame-ancestors 'none';

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/404.html
  Cache-Control: no-store

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
