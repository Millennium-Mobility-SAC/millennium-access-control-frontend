# Variables de entorno para producción (Cloudflare Pages)
# Configura estas variables en: Cloudflare Dashboard → Pages → tu-proyecto → Settings → Environment variables

# URL base del backend (requerida)
VITE_PLATFORM_API_URL=https://api.tudominio.com/api/v1

# Endpoint oficial de estadias/accesos
VITE_STAYS_ENDPOINT=/stays
VITE_STORAGE_FILES_ENDPOINT=/integrations/storage/files

# Modo mock — desactivado en producción
VITE_USE_MOCK=false
